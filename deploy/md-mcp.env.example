# md-mcp production environment (ADR-0020).
#
# Install as /etc/md-mcp/env, chmod 0600 — this file holds live secrets.
# The SAME file works for the dev loop (`set -a; . env; set +a`) and for
# systemd (`EnvironmentFile=`): keep values that contain spaces single-quoted,
# and never rely on ${…} expansion at load time (neither parser expands it;
# the credential helper below expands ${GITHUB_PAT} at git runtime, which is
# exactly what we want).

# --- core ---------------------------------------------------------------
# Vault directory; must be the git repository toplevel when sync is on.
MD_VAULT=/home/zekaizer/vault
MD_TRANSPORT=http
# Structured JSON logs (one object per line) for shipping via journald to
# VictoriaLogs (ADR-0021). Unset/text = human-readable dev output.
MD_LOG_FORMAT=json

# --- HTTP / auth (ADR-0013/0014) -----------------------------------------
# Loopback bind: cloudflared connects locally, TLS terminates at the tunnel.
MD_HTTP_ADDR=127.0.0.1:7654
# Bearer for Claude Code AND the OAuth /authorize gate for claude.ai.
# Generate: head -c 32 /dev/urandom | base64 | tr '+/' '-_' | tr -d '='
MD_HTTP_TOKEN=REPLACE_ME
# The tunnel's public hostname — required, or the Host guard returns 400.
MD_HTTP_ALLOWED_HOSTS=notes.example.com
# OAuth token store etc. Defaults to ~/.local/state/md-mcp; pin it explicitly
# so the systemd ReadWritePaths= whitelist has a stable target.
MD_STATE_DIR=/home/zekaizer/.local/state/md-mcp

# --- git sync & automation (ADR-0016/0018/0019) ---------------------------
MD_GIT_SYNC=1
MD_GIT_AUTO_COMMIT=1
# Debounced push after the last write batch.
MD_GIT_AUTO_PUSH_SECS=30
# Periodic pull/push. Keep this ON in production: it is the recovery upper
# bound after outages and the cap on push-debounce starvation (ADR-0019/0020).
MD_GIT_SYNC_INTERVAL_SECS=300

# --- GitHub credential, via git's env config (git >= 2.31) ----------------
# The vault is a CLONE, so its .git/config already provides remote.origin.* and
# branch.main.* — do NOT re-declare them here. Declaring branch.main.merge a
# second time makes git see "multiple upstream branches" and refuse to push
# (fetch is unaffected, so it looks healthy until the first push). The env only
# injects the PAT credential helper: the empty value first clears any inherited
# helper (e.g. a global gh helper), then the PAT helper is the only one git uses.
# Fine-grained PAT: one repo, Contents: Read and write.
GITHUB_PAT=REPLACE_ME
GIT_CONFIG_COUNT=2
GIT_CONFIG_KEY_0=credential.helper
GIT_CONFIG_VALUE_0=
GIT_CONFIG_KEY_1=credential.helper
GIT_CONFIG_VALUE_1='!f() { echo "username=zekaizer"; echo "password=${GITHUB_PAT}"; }; f'

# --- optional -------------------------------------------------------------
# Vault introduction note advertised in the MCP server instructions.
# MD_INTRO_NOTE=meta/start-here.md
# Event journal / commit hook (ADR-0017).
# MD_EVENTS=1
# MD_ON_COMMIT_HOOK=/usr/local/bin/my-hook
